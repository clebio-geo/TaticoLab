generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MaterialCategory {
  FILAMENT
  OTHER_SUPPLY
}

model Printer {
  id                 Int       @id @default(autoincrement())
  name               String
  powerWatts         Decimal   @db.Decimal(10, 2)
  acquisitionCost    Decimal   @default(0) @db.Decimal(12, 2)
  usefulLifeHours    Decimal   @default(0) @db.Decimal(12, 2)
  monthlyMaintenance Decimal   @default(0) @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  products           Product[]
}

model Material {
  id           Int              @id @default(autoincrement())
  name         String
  category     MaterialCategory
  manufacturer String?
  type         String?
  color        String?
  spoolWeightG Decimal          @default(0) @db.Decimal(12, 2)
  spoolValue   Decimal          @default(0) @db.Decimal(12, 2)
  unitCost     Decimal          @default(0) @db.Decimal(12, 2)
  unit         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  products     Product[]
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  materialId      Int
  printerId       Int
  pieceWeightG    Decimal  @db.Decimal(12, 2)
  printTimeHours  Decimal  @db.Decimal(12, 2)
  extraSupplyCost Decimal  @default(0) @db.Decimal(12, 2)
  laborCost       Decimal  @default(0) @db.Decimal(12, 2)
  failurePercent  Decimal  @default(0) @db.Decimal(8, 2)
  profitMargin    Decimal  @default(0) @db.Decimal(8, 2)
  suggestedPrice  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  material        Material @relation(fields: [materialId], references: [id])
  printer         Printer  @relation(fields: [printerId], references: [id])
  sales           Sale[]

  @@index([materialId])
  @@index([printerId])
}

model Sale {
  id                     Int      @id @default(autoincrement())
  productId              Int
  quantity               Int
  unitSaleValue          Decimal  @db.Decimal(12, 2)
  totalValue             Decimal  @db.Decimal(12, 2)
  unitProductionCost     Decimal  @default(0) @db.Decimal(12, 2)
  totalProductionCost    Decimal  @default(0) @db.Decimal(12, 2)
  totalProfit            Decimal  @default(0) @db.Decimal(12, 2)
  soldAt                 DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  product                Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([soldAt])
}

model BusinessSettings {
  id                         Int      @id @default(1)
  energyTariff               Decimal  @default(1.10) @db.Decimal(10, 4)
  additionalFixedCostPercent Decimal  @default(10.0) @db.Decimal(8, 2)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
